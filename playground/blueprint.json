{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/filtre-demo/",
  "preferredVersions": {
    "php": "8.2",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "login": true,
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "git:directory",
        "url": "https://github.com/kiwwwilab/kiwwwilab-extend",
        "ref": "claude/beautiful-fermat-pav8zc",
        "refType": "branch"
      },
      "options": {
        "activate": true,
        "targetFolderName": "kiwwwilab-extend"
      }
    },
    {
      "step": "runPHP",
      "code": "<?php\nrequire_once 'wordpress/wp-load.php';\n\nupdate_option( 'permalink_structure', '/%postname%/' );\nflush_rewrite_rules();\n\n$cats = array();\nforeach ( array( 'Disseny', 'Desenvolupament', 'Marketing', 'Sense posts' ) as $name ) {\n\t$t = wp_insert_term( $name, 'category' );\n\t$cats[ $name ] = is_wp_error( $t ) ? 0 : $t['term_id'];\n}\n\n$assign = array( 'Disseny', 'Desenvolupament', 'Marketing' );\nfor ( $i = 1; $i <= 9; $i++ ) {\n\t$cat = $assign[ ( $i - 1 ) % 3 ];\n\twp_insert_post( array(\n\t\t'post_title'    => sprintf( 'Post %d (%s)', $i, $cat ),\n\t\t'post_content'  => '<!-- wp:paragraph --><p>Contingut de prova.</p><!-- /wp:paragraph -->',\n\t\t'post_status'   => 'publish',\n\t\t'post_category' => array( $cats[ $cat ] ),\n\t) );\n}\n\n$content = '<!-- wp:query {\"queryId\":1,\"query\":{\"perPage\":4,\"pages\":0,\"offset\":0,\"postType\":\"post\",\"order\":\"desc\",\"orderBy\":\"date\",\"inherit\":false}} -->\n<div class=\"wp-block-query\"><!-- wp:kiwwwilab/query-filter {\"taxonomy\":\"category\",\"allText\":\"Tots\",\"style\":{\"spacing\":{\"blockGap\":\"12px\"}}} /-->\n\n<!-- wp:post-template -->\n<!-- wp:post-title {\"isLink\":true,\"fontSize\":\"medium\"} /-->\n<!-- wp:post-terms {\"term\":\"category\"} /-->\n<!-- /wp:post-template -->\n\n<!-- wp:query-pagination -->\n<!-- wp:query-pagination-previous /-->\n<!-- wp:query-pagination-numbers /-->\n<!-- wp:query-pagination-next /-->\n<!-- /wp:query-pagination -->\n\n<!-- wp:query-no-results -->\n<!-- wp:paragraph --><p>No hi ha resultats.</p><!-- /wp:paragraph -->\n<!-- /wp:query-no-results --></div>\n<!-- /wp:query -->';\n\nwp_insert_post( array(\n\t'post_title'   => 'Filtre demo',\n\t'post_name'    => 'filtre-demo',\n\t'post_type'    => 'page',\n\t'post_status'  => 'publish',\n\t'post_content' => wp_slash( $content ),\n) );\n"
    }
  ]
}
